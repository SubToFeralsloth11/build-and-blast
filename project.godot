; Engine configuration file.
config_version=5

[application]

config/name="Build & Blast"
config/description="Design wild vehicles from blocks and test them in the desert, the sea and the sky."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Blocks="*res://scripts/blocks.gd"
Controls="*res://scripts/controls.gd"
Sfx="*res://scripts/sfx.gd"
Fx="*res://scripts/fx.gd"
Designs="*res://scripts/designs.gd"
Power="*res://scripts/power.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
